# ============================
# PolyMetric 环境变量配置模板
# ============================
# 复制此文件为 .env 并修改相应的值

# ============================
# Django 配置
# ============================
# ⚠️ 必须修改：Django 密钥（至少 50 个字符）
# 生成命令: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=5M0Xgjw-i-y4jGyJJw5S_ioa9HwcZan2nIMAAnJLmekAK902J5mCTvhzYJma2SqINQA

# ============================
# 数据库配置 (PostgreSQL)
# ============================
DB_NAME=polymetric
DB_USER=polymetric_user
# ⚠️ 必须修改：数据库密码
DB_PASSWORD=db_password_strong

# ============================
# Redis 配置
# ============================
# ⚠️ 必须修改：Redis 密码
REDIS_PASSWORD=redis_password_strong

# ============================
# 服务器配置
# ============================
# ⚠️ 必须修改：服务器 IP 地址或域名
# 换服务器时只需修改这一个值，其他配置会自动生效
SERVER_IP=124.220.26.26

# 安全配置
# 开发环境：使用 localhost
# 生产环境：使用 ${SERVER_IP}，会自动替换为上面配置的值
ALLOWED_HOSTS=localhost,127.0.0.1,${SERVER_IP}
CORS_ALLOWED_ORIGINS=http://localhost,http://${SERVER_IP}

# ============================
# 端口配置（可选）
# ============================
HTTP_PORT=8080
HTTPS_PORT=8443
