# ===========================================
# PolyMetric 生产环境配置模板
# ===========================================
# 使用说明：
# 1. 复制此文件为 .env: cp .env.example .env
# 2. 修改下面的配置项为实际值
# 3. 不要将 .env 文件提交到版本控制

# Django 配置
SECRET_KEY=your-secret-key-here-change-it-in-production
DEBUG=False
ALLOWED_HOSTS=your-domain.com,www.your-domain.com,localhost

# 跨域配置
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# 数据库配置
DB_NAME=polymetric
DB_USER=polymetric_user
DB_PASSWORD=your-strong-db-password
DB_HOST=db
DB_PORT=5432

# Redis 配置
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your-strong-redis-password

# 端口配置
HTTP_PORT=8080
HTTPS_PORT=8443

# Email 配置（可选）
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-password

# 其他配置
CELERY_BROKER_URL=redis://:your-strong-redis-password@redis:6379/0
CELERY_RESULT_BACKEND=redis://:your-strong-redis-password@redis:6379/0
