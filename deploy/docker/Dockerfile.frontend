# Frontend Dockerfile for PolyMetric Vue Application
# 改回官方镜像名（本地已拉取，无需下载）
FROM node:20-alpine AS builder

# 设置工作目录
WORKDIR /app

# 使用国内 npm 镜像源
RUN npm config set registry https://registry.npmmirror.com

# 1. 只复制 package 文件（利用 Docker 缓存）
COPY PolyMetric/frontend/package*.json ./

# 2. 安装依赖（只有 package.json 改变时才重新执行）
RUN npm install

# 3. 复制源代码（放在依赖安装之后）
COPY PolyMetric/frontend ./

# 4. 构建参数：允许在构建时传入 API 地址
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

# 5. 构建生产版本
RUN npm run build

# ===================================
# 生产环境镜像（多阶段构建，减小体积）
# ===================================
# 改回官方镜像名（本地已拉取）
FROM nginx:alpine

# 复制构建产物
COPY --from=builder /app/dist /usr/share/nginx/html

# 复制 nginx 配置
COPY deploy/nginx/frontend.conf /etc/nginx/conf.d/default.conf

# 暴露端口
EXPOSE 80

# 启动 nginx
CMD ["nginx", "-g", "daemon off;"]