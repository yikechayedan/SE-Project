# Frontend Dockerfile for PolyMetric Vue Application
FROM node:20-alpine AS builder

# 设置工作目录
WORKDIR /app

# 复制 package 文件
COPY PolyMetric/frontend/package*.json ./

# 安装依赖
RUN npm install

# 复制源代码
COPY PolyMetric/frontend ./

# 构建生产版本
RUN npm run build

# 生产环境镜像
FROM nginx:alpine

# 复制构建产物
COPY --from=builder /app/dist /usr/share/nginx/html

# 复制 nginx 配置
COPY deploy/nginx/frontend.conf /etc/nginx/conf.d/default.conf

# 暴露端口
EXPOSE 80

# 启动 nginx
CMD ["nginx", "-g", "daemon off;"]
