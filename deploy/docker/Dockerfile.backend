# Backend Dockerfile for PolyMetric Django Application
FROM python:3.11-slim

# 设置工作目录
WORKDIR /app

# 使用国内镜像源加速 apt
RUN sed -i 's/deb.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list.d/debian.sources \
    && sed -i 's|security.debian.org/debian-security|mirrors.aliyun.com/debian-security|g' /etc/apt/sources.list.d/debian.sources

# 安装系统依赖
# ⚠️ 新增 libpq-dev 以支持 postgres 驱动编译
RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    postgresql-client \
    netcat-traditional \
    && rm -rf /var/lib/apt/lists/*

# 复制依赖文件
COPY PolyMetric/backend/requirements.txt .

# 使用国内 pip 镜像源
RUN pip config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple

# 安装 Python 依赖
# ⚠️ 加上 --upgrade pip 保证安装顺利
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt gunicorn

# 复制后端代码
COPY PolyMetric/backend /app

# 创建媒体文件目录
RUN mkdir -p /app/media/avatars /app/media/datasets

# 收集静态文件
# ⚠️ 如果数据库还没启动，这一步可能会报错，所以加了 || true 忽略错误
# 真正的 collectstatic 会在启动命令中再次执行
RUN python manage.py collectstatic --noinput || true

# 暴露端口
EXPOSE 8000

# 启动命令（默认命令，会被 docker-compose 覆盖）
CMD ["gunicorn", "PolyMetric.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "3"]